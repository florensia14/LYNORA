# ==========================================
# LYNORA BACKEND - CONTOH KONFIGURASI
# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env yang berisi kredensial asli.
# ==========================================

# ------------------------------------------
# SERVER
# ------------------------------------------
PORT=5000

# ------------------------------------------
# DATABASE (MySQL / MariaDB)
# ------------------------------------------
DB_HOST=localhost
DB_USER=lynora_user
DB_PASSWORD=ganti_dengan_password_database
DB_NAME=lynora_db

# ------------------------------------------
# AUTENTIKASI
# ------------------------------------------
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d

# ------------------------------------------
# MIDTRANS
# ------------------------------------------
# false = Sandbox (pengembangan), true = Production (uang nyata).
# WAJIB cocok dengan format key yang dipakai:
#   Sandbox  : SB-Mid-server-xxxxx / SB-Mid-client-xxxxx
#   Produksi : Mid-server-xxxxx    / Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false

# Server Key HANYA untuk backend. Jangan pernah dikirim ke frontend.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Client Key aman dipakai di frontend (dipakai memuat snap.js).
# Backend tidak mewajibkannya untuk membuat transaksi Snap.
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------
# RATE LIMIT WEBHOOK MIDTRANS
# ----------------------------------------------------
# Jendela waktu dalam milidetik (default 60000 = 1 menit)
MIDTRANS_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# Jumlah maksimum notifikasi per IP dalam satu jendela waktu
MIDTRANS_WEBHOOK_RATE_LIMIT_MAX=60

# ------------------------------------------
# PENYIMPANAN BUKTI TRANSFER
# ------------------------------------------
# Direktori penyimpanan bukti transfer (relatif terhadap folder backend
# atau absolut). Default: <backend>/uploads/payments
# PAYMENT_PROOF_DIR=uploads/payments
